{
  "version": 2,
  "buildCommand": "npm run build --workspace=packages/client",
  "outputDirectory": "packages/client/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/packages/client/dist/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/packages/client/dist/index.html"
    }
  ]
}
