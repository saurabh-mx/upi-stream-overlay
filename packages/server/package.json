    "express": "^5.1.0",
    "google-auth-library": "^11.0.2",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^5.1.3",
    "pg": "^8.13.3",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1",
    "speakeasy": "^2.0.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.9",
